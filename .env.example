# .env.example (PLACEHOLDERS)
APP_NAME=RealtimeApp
APP_ENV=local
APP_KEY=base64:GENERATED_BY_ARTISAN
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realtime_system
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
BROADCAST_DRIVER=reverb

# Reverb (WebSocket) application credentials (local placeholders)
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# Where to reach the Reverb server from clients
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
# Where Laravel sends broadcast messages (usually same host+port)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
